# Spring Boot: local environment. Java does not automatically load this file.
PORT=8080
# Optional Vite proxy target (local backend)
BACKEND_URL=http://127.0.0.1:8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/huce_spring
DB_USER=fm05
DB_PASSWORD=fm05_local
DEMO=false
COOKIE_SECURE=false
# Distinct cookie names if running several native backends on the same host.
SESSION_COOKIE_NAME=HUCE_SPRING_SID
# Optional: set on backend only
GEMINI_API_KEY=
GEMINI_MODEL=
